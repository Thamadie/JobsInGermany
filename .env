# Copy this file to .env and fill in your values. Never commit .env.

# MongoDB Atlas connection string (Atlas → your cluster → Connect → Drivers).
# Replace <username> and <password> with a database user from Atlas → Database Access.
# If the password contains special characters such as @ : / ? # use URL encoding (e.g. @ → %40).
MONGODB_URI=mongodb+srv://admin:admin@jobsingermany.5mnlo9u.mongodb.net/?retryWrites=true&w=majority

# Database name (created automatically on first start)
MONGODB_DB=jobsingermany

# Admin panel login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminBelmont@

# Port for the web server
PORT=5000

# Only if startup fails with "querySrv ECONNREFUSED": DNS servers to use for the
# Atlas lookup. The app already retries with these automatically.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Set to 1 when running behind a hosting proxy (Render, Railway, Heroku, Nginx)
# TRUST_PROXY=1
